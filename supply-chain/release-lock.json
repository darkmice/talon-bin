  "runtime_attestation": {
    "status": "ready",
    "reason": "Four-target build-manifest challenges, C ABI smoke, Core prefix-scan conformance, and signed SDK native acceptance passed in Actions run 36878054786; release mode repeats these checks from main.",
    "manifest_version": 2,
    "abi_profile": "talon-native-c",
    "abi_version": 1,
    "required_symbols": [
      "talon_open",

      "native_error_codes_v1",
      "native_kv_read_v1",
      "sql_tlv_v1",
      "native_sql_session_v1",
      "native_shared_core_v1",
      "native_sql_result_v2",
      "storage_conditional_batch_v1",
      "storage_conditional_point_read_v1",
      "storage_conditional_snapshot_read_v1",
      "storage_conditional_snapshot_read_v2",
      "storage_conditional_prefix_scan_v1",
      "native_conditional_transaction_v2",
      "native_conditional_compact_receipt_v3",
      "conditional_compact_receipt_v3_wire_v1",
      "conditional_compact_receipt_v3_digest_v1",
      "conditional_transaction_command_digest_v1",
      "revision_stream_v1",
      "revision_stream_v2_mmr_proof"
    ],
    "capabilities": [
      {
        "name": "native_sql_session",
        "version": 1,
        "status": "available"
      },
      {
        "name": "native_shared_core",
        "version": 1,
        "status": "available"
      },
      {
        "name": "native_sql_result",
        "version": 2,
        "status": "available"
      },
      {
        "name": "native_kv_read",
        "version": 1,
        "status": "available"
      },
      {
        "name": "native_goframe_gredis",
        "version": 1,
        "status": "gated",
        "reason": "Hash, List, Set, SortedSet, PubSub, Script, millisecond expiry, signed release artifact and GoFrame conformance remain open"
      },
      {
        "name": "storage_conditional_batch",
        "version": 1,
        "status": "available"
      },
      {
        "name": "native_conditional_transaction_v2",
        "version": 2,
        "status": "available"
      },
      {
        "name": "storage_conditional_compact_receipt",
        "version": 3,
        "status": "available",
        "limits": {
          "max_conditions": 128,
          "max_mutations": 128,
          "max_key_bytes": 8192,
          "max_receipt_bytes": 16777216,
          "server_http_max_request_bytes": 67108864,
          "allowed_condition_operators": [
            "eq",
            "ne"
          ],
          "receipt_authentication": "integrity_only_unkeyed_sha256"
        }
      },
      {
        "name": "storage_conditional_point_read",
        "version": 1,
        "status": "gated",
        "reason": "snapshot-bound identity/revision verification is implemented, but SDK cross-target conformance and release artifact binding remain open"
      },
      {
        "name": "storage_conditional_snapshot_read",
        "version": 1,
        "status": "gated",
        "reason": "bounded keys and one MVCC snapshot are implemented, but historical reads, SDK cross-target conformance, and release artifact binding remain open"
      },
      {
        "name": "storage_conditional_snapshot_read",
        "version": 2,
        "status": "available"
      },
      {
        "name": "storage_conditional_prefix_scan",
        "version": 1,
        "status": "available",
        "reason": "opaque continuation cursors are bounded node-local MVCC snapshot leases and fail closed after expiry, restart, or node change"
      },
      {
        "name": "revision_stream",
        "version": 2,
        "status": "gated",
        "reason": "v2 authenticates fixed-head pages with MMR inclusion and boundary proofs, but SDK cross-target conformance, release capacity, recovery fixtures, and adversarial soak evidence remain open; legacy v1 remains linear"
      },
      {
        "name": "native_quorum",
        "version": 1,
        "status": "gated",
        "reason": "only storage conditional batches enter the single quorum log; remaining mutation families are fail-closed"
      },
      {
        "name": "server_ha_production_admission",
        "version": 1,
        "status": "gated",
        "reason": "TLS, full fault matrix, recovery compatibility, capacity, and mixed-version evidence remain open"
      }
    ]
  },
  "build": {
    "rust_toolchain": "1.92.0",
    "cargo_args": [
      "build",
      "--locked",
      "--release",
      "--lib"
    ],
    "reproducibility": "exact source and toolchain with deterministic packaging; native code bytes are not claimed reproducible across mutable hosted runner images"
  },
  "signing": {
    "status": "ready",
    "algorithm": "Ed25519",
    "key_id": "talon-enterprise-core-2026-10-01",
    "public_key_sha256": "617eca89ae8b1e824b5ae764cee171f98eff07e16123e7a0dbead73425b1fa2c",
    "reason": "Production Ed25519 public key is pinned and the matching GitHub Actions secret is configured; four-target candidate admission passed in Actions run 36878054786."
  },
  "targets": [
    {
      "platform": "linux-amd64",
      "triple": "x86_64-unknown-linux-gnu",
      "runner": "ubuntu-24.04",
      "static_library": "libtalon.a",
